{
  "expo": {
    "name": "TileKeeper",
    "slug": "modular-realms-tilekeeper",
    "version": "0.1.0",
    "scheme": "tilekeeper",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.modularrealms.tilekeeper",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UISupportsDocumentBrowser": true,
        "NSPhotoLibraryUsageDescription": "TileKeeper uses the photo library to share exported layout images and PDF prep sheets.",
        "NSCameraUsageDescription": "Camera access is not used by TileKeeper."
      }
    },
    "android": {
      "package": "com.modularrealms.tilekeeper"
    },
    "web": {
      "bundler": "metro"
    },
    "owner": "richardevans502",
    "extra": {
      "eas": {
        "projectId": "6713aeae-2dd4-44bd-9a05-0a343b1cdad1"
      }
    }
  }
}
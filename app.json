{
  "expo": {
    "name": "TileKeeper",
    "slug": "modular-realms-tilekeeper",
    "version": "0.1.0",
    "scheme": "tilekeeper",
    "orientation": "portrait",
    "platforms": ["android", "ios", "web"],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.modularrealms.tilekeeper"
    },
    "android": {
      "package": "com.modularrealms.tilekeeper"
    },
    "web": {
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A",
      "imageWidth": 200,
      "dark": {
        "image": "./assets/images/splash-dark.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      }
    }
  }
}

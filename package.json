{
  "name": "modular-realms-tilekeeper",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build:web": "expo export --platform web --output-dir dist-web",
    "build:ios:simulator": "eas build --platform ios --profile development",
    "build:ios:internal": "eas build --platform ios --profile preview",
    "build:ios:testflight": "eas build --platform ios --profile production",
    "submit:ios:testflight": "eas submit --platform ios --profile production --latest",
    "ci": "npm run typecheck && npm test && npm run build:web",
    "diagnostics:replay": "tsx scripts/replay-diagnostics.ts",
    "catalog:build": "tsx scripts/build-catalog-pack.ts",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "dependencies": {
    "@expo/log-box": "^56.0.12",
    "@expo/metro-runtime": "~56.0.15",
    "expo": "~56.0.12",
    "expo-constants": "^56.0.17",
    "expo-file-system": "^56.0.8",
    "expo-linking": "~56.0.14",
    "expo-print": "^56.0.4",
    "expo-router": "~56.2.11",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "^56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "@types/react": "~19.2.14",
    "hermes-engine-cli": "^0.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-modules-core": "56.0.14",
    "expo-modules-autolinking": "56.0.14",
    "js-yaml": "4.2.0",
    "uuid": "11.1.1"
  }
}
